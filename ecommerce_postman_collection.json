			"name": "1. Authentication",
			"item": [
				{
					"name": "Register User",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"correlationId\": \"reg-user-001\",\n    \"data\": {\n        \"userName\": \"John Doe\",\n        \"email\": \"john@example.com\",\n        \"password\": \"password123\",\n        \"phoneNumber\": \"1234567890\"\n    }\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{user_service_url}}/api/user/register",
							"host": [
								"{{user_service_url}}"
							],
							"path": [
								"api",
								"user",
								"register"
							]
						}
					},
					"response": []
				},
				{
					"name": "User Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if(jsonData.data && jsonData.data.accessToken) {",
									"    pm.environment.set(\"user_token\", jsonData.data.accessToken);",
									"    pm.environment.set(\"user_id\", jsonData.data.userId);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"correlationId\": \"login-user-001\",\n    \"data\": {\n        \"email\": \"john@example.com\",\n        \"password\": \"password123\"\n    }\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{user_service_url}}/api/user/login",
							"host": [
								"{{user_service_url}}"
							],
							"path": [
								"api",
								"user",
								"login"
							]
						}
					},
					"response": []
				},
